    characterSetSelectionMode: 8
    characterSequence: "\u901A\u98CE\u6F14\u793A \u6E05\u6D01 \u9694\u7EDD \u6EE4\u6BD2
      \u4E0D\u5F00\u542F\r\n\u63D0\u4EA4\u672C\u9898 \u4E0B\u4E00\u9898 \u6559\u5B66\u6F14\u793A
      \u5F00\u59CB\u7B54\u9898 \u5F97\u5206 \u5F53\u524D\u8FDB\u5EA6 / \u9000\u51FA\r\n\u5F00\u542F
      \u5173\u95ED\r\n\r\n\r\n[\r\n  {\r\n    \"id\": 1,\r\n    \"questions\": \"\u4EBA\u9632\u95E8\u52A0\u5F3A\u6881\u662F\u5426\u7B26\u5408\u8BBE\u8BA1\u53CA\u89C4\u8303\u8981\u6C42\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      1,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u6A2A\u6881\u5E94\u6A2A\u8DE8\u5899\u9762\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 2,\r\n    \"questions\": \"\u4EBA\u9632\u540A\u94A9\u9884\u57CB\u8BBE\u7F6E\u662F\u5426\u7B26\u5408\u8BBE\u8BA1\u53CA\u89C4\u8303\u8981\u6C42\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      0,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u6B63\u786E\u8BBE\u7F6E\u540A\u94A9\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 3,\r\n    \"questions\": \"\u4E34\u7A7A\u5899\u3001\u9632\u62A4\u5BC6\u95ED\u5899\u3001\u5BC6\u95ED\u5899\u548C\u4E34\u6218\u5C01\u5835\u4E0A\u90E8\u6881\u5957\u7BA1\u6750\u8D28\u662F\u5426\u6B63\u786E\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      1,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u5957\u7BA1\u6750\u8D28\u5E94\u4E3A\u5B9E\u5FC3\u94F8\u94C1\u7BA1\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 4,\r\n    \"questions\": \"\u6218\u65F6\u5BC6\u95ED\u901A\u9053\u5904\u9884\u57CB\u5957\u7BA1\u662F\u5426\u9884\u57CB\u5230\u4F4D\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      1,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u5957\u7BA1\u672A\u9884\u57CB\u5230\u4F4D\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 5,\r\n    \"questions\": \"\u4EBA\u9632\u5DE5\u7A0B\u6807\u8BC6\u6807\u724C\u8BBE\u7F6E\u662F\u5426\u7B26\u5408\u8981\u6C42\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      1,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u7F3A\u5C11\u4EBA\u9632\u8F66\u4F4D\u5730\u9762\u6807\u8BC6\u53CA\u60AC\u6302\u6807\u8BC6\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 6,\r\n    \"questions\": \"\u7A7F\u8D8A\u4EBA\u9632\u56F4\u62A4\u7ED3\u6784\u7684\u7ED9\u6392\u6C34\u7BA1\u5728\u4EBA\u9632\u533A\u5185\u4FA7\u52A0\u8BBE\u9632\u62A4\u9600\u95E8\u662F\u5426\u7B26\u5408\u8BBE\u8BA1\u53CA\u89C4\u8303\u8981\u6C42\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      1,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u7ED9\u6392\u6C34\u7BA1\u5E94\u8BBE\u6709\u9600\u95E8\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 7,\r\n    \"questions\": \"\u60AC\u6446\u6D3B\u95E8\u6807\u8BC6\u662F\u5426\u5B8C\u6574\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u7F3A\u542F\u95ED\u6807\u8BC6\",\r\n      \"\u7F3A\u5C11\u94ED\u724C\",\r\n     
      \"\u7F3A\u5C11\u95ED\u6807\u8BC6\u548C\u94ED\u724C\",\r\n      \"\u4EC0\u4E48\u90FD\u4E0D\u7F3A\"\r\n   
      ],\r\n    \"correctAnswer\": 2,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u60AC\u6446\u6D3B\u95E8\u5E94\u5F53\u5305\u542B\u64CD\u4F5C\u6807\u8BC6\u53CA\u94ED\u724C\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 8,\r\n    \"questions\": \"\u6269\u5C55\u5BA4\u5185\u7684\u5899\u4F53\u662F\u5426\u5149\u9762\u5904\u7406\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      0,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u5899\u4F53\u5DF2\u5149\u9762\u5904\u7406\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 9,\r\n    \"questions\": \"\u662F\u5426\u6B63\u786E\u5B89\u88C5\u9632\u7206\u5730\u6F0F\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      1,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u9632\u7206\u5730\u6F0F\u7A81\u51FA\uFF0C\u672A\u6B63\u786E\u5B89\u88C5\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 10,\r\n    \"questions\": \"\u6218\u65F6\u4EBA\u5458\u51FA\u5165\u53E3\u90E8\u3001\u8FDB\u98CE\u673A\u623F\u3001\u5355\u5143\u95F4\u8054\u901A\u53E3\u3001\u9632\u5316\u503C\u73ED\u5BA4\u7B49\u90E8\u4F4D\u7684\u4E09\u8272\u4FE1\u53F7\u706F\u5B89\u88C5\u662F\u5426\u7B26\u5408\u8981\u6C42\uFF1F\",\r\n   
      \"answers\": [\r\n      \"\u662F\",\r\n      \"\u5426\"\r\n    ],\r\n    \"correctAnswer\":
      1,\r\n    \"explain\": \"\u672C\u793A\u4F8B\u4E2D\u7F3A\u5C11\u5B89\u88C5\u4E09\u8272\u4FE1\u53F7\u706F\u3002\"\r\n 
      },\r\n  {\r\n    \"id\": 11,\r\n    \"questions\": \"\u9A6C\u51F3\u662F\u5426\u8BBE\u7F6E\u5230\u4F4D\uFF1F\",\r\n   
